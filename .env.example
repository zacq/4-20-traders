# Airtable credentials used by netlify/functions/submit-lead.js
# Set the real values in Netlify: Site settings -> Environment variables
# Never commit the actual token to git.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=app19rrcmc7b9aecC
AIRTABLE_TABLE_ID=tblTiFOX1T1oNjbDY

# PayHero credentials — NOT used by the Netlify functions anymore (payment
# collection now goes through the embedded PayHero Payment Button widget in
# index.html, pointed at https://lipwa.link/10976). These are only needed
# by the n8n workflows in n8n-workflows/ for server-side reconciliation.
# From your PayHero dashboard: Menu -> API Credentials -> copy the "Basic ..." token
PAYHERO_BASIC_AUTH_TOKEN=
# Your payment/wallet channel ID (Menu -> Payment Channels)
PAYHERO_CHANNEL_ID=
