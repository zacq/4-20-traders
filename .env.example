# Airtable credentials used by netlify/functions/initiate-payment.js,
# payhero-webhook.js and payhero-poller.js.
# Set the real values in Netlify: Site settings -> Environment variables
# Never commit the actual token to git.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=app19rrcmc7b9aecC
AIRTABLE_TABLE_ID=tblTiFOX1T1oNjbDY

# PayHero credentials used by payhero-webhook.js and payhero-poller.js to
# verify transaction status server-side (payment collection itself goes
# through the embedded PayHero Payment Button widget in index.html,
# pointed at https://lipwa.link/10976).
# From your PayHero dashboard: Menu -> API Keys -> copy the "Basic ..." token
PAYHERO_BASIC_AUTH_TOKEN=

# Optional: shared secret for payhero-webhook.js. If set, incoming callbacks
# are expected to include ?token=<this value> in the callback URL. Currently
# logged-only (not enforced) until it's confirmed PayHero preserves query
# strings on the saved account-level callback URL.
PAYHERO_WEBHOOK_SECRET=
